{
  "api_key": {
    "description": "API Key",
    "type": "string",
    "hint": "填写 api.xbyjs.top 的 API Key。也可以不填，改用环境变量 OPENAI_API_KEY。",
    "obvious_hint": true,
    "default": ""
  },
  "base_url": {
    "description": "API Base URL",
    "type": "string",
    "hint": "默认使用 https://api.xbyjs.top。",
    "default": "https://api.xbyjs.top"
  },
  "endpoint": {
    "description": "图片生成接口路径",
    "type": "string",
    "hint": "api.xbyjs.top 的 OpenAI 兼容图片生成路径。",
    "default": "/v1/images/generations"
  },
  "model": {
    "description": "图片模型",
    "type": "string",
    "hint": "可选：gpt-image-2、gpt-image-2-2k、gpt-image-2-4k。",
    "default": "gpt-image-2"
  },
  "size": {
    "description": "图片尺寸",
    "type": "string",
    "hint": "常用值：1024x1024、1024x1536、1536x1024。具体支持范围取决于模型和服务商。",
    "default": "1024x1024"
  },
  "quality": {
    "description": "图片质量",
    "type": "string",
    "hint": "常用值：auto、low、medium、high。兼容服务不支持时可留空。",
    "default": "auto"
  },
  "output_format": {
    "description": "输出格式",
    "type": "string",
    "hint": "常用值：png、jpeg、webp。具体支持范围取决于模型和服务商。",
    "default": "png"
  },
  "timeout": {
    "description": "请求超时时间",
    "type": "int",
    "hint": "单位：秒。",
    "default": 120
  },
  "keywords": {
    "description": "免斜杠触发关键词",
    "type": "list",
    "hint": "用户可直接发送“画图 描述”触发。斜杠命令固定支持 /gptimg、/画图、/绘图、/生成图片、/gpt-img-2。",
    "default": ["画图", "绘图", "生成图片", "gptimg", "gpt-img-2"]
  },
  "extra_body": {
    "description": "额外请求体参数",
    "type": "object",
    "hint": "用于兼容不同服务商的额外参数，会覆盖同名默认参数。",
    "items": {},
    "default": {}
  },
  "selfie": {
    "description": "自拍参考照模式",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用自拍参考照",
        "type": "bool",
        "default": true
      },
      "reference_images": {
        "description": "WebUI 上传的自拍参考图",
        "type": "file",
        "hint": "可上传清晰正脸照；不填时，可通过“发送图片 + /自拍参考 设置”保存参考照。",
        "file_types": ["jpg", "jpeg", "png", "webp"],
        "default": []
      },
      "edit_endpoint": {
        "description": "图片编辑接口路径",
        "type": "string",
        "hint": "自拍会使用 OpenAI 兼容 images/edits 接口。",
        "default": "/v1/images/edits"
      },
      "model": {
        "description": "自拍模型",
        "type": "string",
        "hint": "留空时复用上方 model。可填 gpt-image-2、gpt-image-2-2k、gpt-image-2-4k。",
        "default": "gpt-image-2"
      },
      "size": {
        "description": "自拍图片尺寸",
        "type": "string",
        "hint": "留空时复用上方 size。",
        "default": "1024x1024"
      },
      "quality": {
        "description": "自拍图片质量",
        "type": "string",
        "hint": "留空时复用上方 quality。",
        "default": "auto"
      },
      "output_format": {
        "description": "自拍输出格式",
        "type": "string",
        "hint": "留空时复用上方 output_format。",
        "default": "png"
      },
      "max_reference_images": {
        "description": "最多提交参考图数量",
        "type": "int",
        "hint": "第一张作为身份参考，当前消息中的图片可作为额外服装、姿势、场景参考。",
        "default": 2
      },
      "recent_image_ttl_seconds": {
        "description": "最近图片缓存时间",
        "type": "int",
        "hint": "先发送图片，再输入 /自拍参考 设置 时，图片可被记住多久。",
        "default": 600
      },
      "image_field": {
        "description": "multipart 图片字段名",
        "type": "string",
        "hint": "多数 OpenAI 兼容 images/edits 使用 image；若网关要求 image[] 可改这里。",
        "default": "image"
      },
      "prompt_prefix": {
        "description": "自拍提示词前缀",
        "type": "text",
        "hint": "留空使用内置自拍参考照提示词。",
        "default": ""
      },
      "extra_body": {
        "description": "自拍额外请求体参数",
        "type": "object",
        "hint": "用于兼容不同服务商的 images/edits 额外字段。",
        "items": {},
        "default": {}
      }
    }
  }
}
