{
  "api_key": {
    "description": "API Key",
    "type": "string",
    "hint": "填写 api.xbyjs.top 的 API Key。也可以不填，改用环境变量 OPENAI_API_KEY。",
    "obvious_hint": true,
    "default": ""
  },
  "base_url": {
    "description": "API Base URL",
    "type": "string",
    "hint": "默认使用 https://api.xbyjs.top。",
    "default": "https://api.xbyjs.top"
  },
  "endpoint": {
    "description": "图片生成接口路径",
    "type": "string",
    "hint": "api.xbyjs.top 的 OpenAI 兼容图片生成路径。",
    "default": "/v1/images/generations"
  },
  "model": {
    "description": "图片模型",
    "type": "string",
    "hint": "可选：gpt-image-2、gpt-image-2-2k、gpt-image-2-4k。",
    "default": "gpt-image-2"
  },
  "size": {
    "description": "图片尺寸",
    "type": "string",
    "hint": "默认 auto：按提示词自动选择方图/竖图/横图。也可固定为 1024x1024、1024x1536、1536x1024。",
    "default": "auto"
  },
  "quality": {
    "description": "图片质量",
    "type": "string",
    "hint": "常用值：auto、low、medium、high。兼容服务不支持时可留空。",
    "default": "auto"
  },
  "output_format": {
    "description": "输出格式",
    "type": "string",
    "hint": "常用值：png、jpeg、webp。具体支持范围取决于模型和服务商。",
    "default": "png"
  },
  "timeout": {
    "description": "请求超时时间",
    "type": "int",
    "hint": "单位：秒。",
    "default": 120
  },
  "keywords": {
    "description": "免斜杠触发关键词",
    "type": "list",
    "hint": "用户可直接发送“画图 描述”触发。斜杠命令固定支持 /gptimg、/画图、/绘图、/生成图片、/gpt-img-2。",
    "default": ["画图", "绘图", "生成图片", "gptimg", "gpt-img-2"]
  },
  "natural_image_enabled": {
    "description": "自然语言文生图触发",
    "type": "bool",
    "hint": "开启后，“帮我生成一个xxx图片”“我要一张xxx图”“我想看烟花”等会直接生成普通图片。",
    "default": true
  },
  "extra_body": {
    "description": "额外请求体参数",
    "type": "object",
    "hint": "用于兼容不同服务商的额外参数，会覆盖同名默认参数。",
    "items": {},
    "default": {}
  },
  "tts": {
    "description": "火山语音合成",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用语音合成",
        "type": "bool",
        "hint": "开启后支持 /语音、/tts、/说话 和 LLM 工具 gpt_img_2_speak。",
        "default": true
      },
      "app_id": {
        "description": "火山 App ID",
        "type": "string",
        "hint": "火山引擎语音合成 App ID。也可用环境变量 VOLC_TTS_APP_ID。",
        "default": "9694280449"
      },
      "access_token": {
        "description": "火山 Access Token",
        "type": "string",
        "hint": "火山引擎语音合成 Access Token。也可用环境变量 VOLC_TTS_ACCESS_TOKEN。",
        "obvious_hint": true,
        "default": ""
      },
      "secret_key": {
        "description": "火山 Secret Key",
        "type": "string",
        "hint": "预留给火山 V3 鉴权使用；当前无额外依赖的 HTTP 合成路径不需要它。",
        "obvious_hint": true,
        "default": ""
      },
      "base_url": {
        "description": "火山接口 Base URL",
        "type": "string",
        "hint": "默认使用 https://openspeech.bytedance.com。",
        "default": "https://openspeech.bytedance.com"
      },
      "api_version": {
        "description": "火山接口版本",
        "type": "string",
        "hint": "默认 v3。S_ 开头的声音复刻音色建议使用 v3；旧版音色可改为 v1。",
        "default": "v3"
      },
      "endpoint": {
        "description": "V1 语音合成接口路径",
        "type": "string",
        "hint": "api_version=v1 时使用。",
        "default": "/api/v1/tts"
      },
      "v3_endpoint": {
        "description": "V3 语音合成接口路径",
        "type": "string",
        "hint": "api_version=v3 时使用。",
        "default": "/api/v3/tts/unidirectional"
      },
      "resource_id": {
        "description": "V3 Resource ID",
        "type": "string",
        "hint": "S_ 开头的声音复刻音色通常使用 seed-icl-2.0；如控制台另有 Resource ID，在这里修改。",
        "default": "seed-icl-2.0"
      },
      "cluster": {
        "description": "火山集群",
        "type": "string",
        "hint": "api_version=v1 时使用。常见值 volcano_tts；如果控制台给了其它 cluster，在这里改。",
        "default": "volcano_tts"
      },
      "voice_type": {
        "description": "音色 ID",
        "type": "string",
        "hint": "默认使用你提供的音色 ID。",
        "default": "S_RaFCxn8Q1"
      },
      "encoding": {
        "description": "音频格式",
        "type": "string",
        "hint": "建议 mp3；部分平台可能会自行转换语音格式。",
        "default": "mp3"
      },
      "send_mode": {
        "description": "语音发送模式",
        "type": "string",
        "hint": "auto=自动判断；record=强制语音段；file=强制文件兜底。微信 OC/个人微信通常不支持语音段，auto 会走文件兜底。",
        "default": "auto"
      },
      "send_file_fallback": {
        "description": "启用文件兜底",
        "type": "bool",
        "hint": "当平台不支持语音段时，发送文本+mp3 文件；关闭后只发文本和本地路径。",
        "default": true
      },
      "sample_rate": {
        "description": "采样率",
        "type": "int",
        "hint": "V3 音频采样率，默认 24000。",
        "default": 24000
      },
      "speed_ratio": {
        "description": "语速",
        "type": "float",
        "hint": "1.0 为正常语速。",
        "default": 1.0
      },
      "volume_ratio": {
        "description": "音量",
        "type": "float",
        "hint": "1.0 为正常音量。",
        "default": 1.0
      },
      "pitch_ratio": {
        "description": "音调",
        "type": "float",
        "hint": "1.0 为正常音调。",
        "default": 1.0
      },
      "max_chars": {
        "description": "单次最大字符数",
        "type": "int",
        "hint": "避免一次合成过长文本。",
        "default": 300
      },
      "timeout": {
        "description": "请求超时时间",
        "type": "int",
        "hint": "单位：秒。",
        "default": 60
      },
      "extra_body": {
        "description": "语音额外请求体参数",
        "type": "object",
        "hint": "用于覆盖火山 TTS 请求体里的字段，例如 app/audio/request 内的细节。",
        "items": {},
        "default": {}
      }
    }
  },
  "proactive": {
    "description": "主动状态图",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用主动状态图",
        "type": "bool",
        "hint": "开启后，插件会按间隔向订阅会话主动发送状态图。仍需要在目标聊天里执行 /状态图 开启。",
        "default": false
      },
      "interval_seconds": {
        "description": "发送间隔",
        "type": "int",
        "hint": "单位：秒。默认 3600，即 1 小时。代码会强制不低于 60 秒。",
        "default": 3600
      },
      "initial_delay_seconds": {
        "description": "启动后延迟",
        "type": "int",
        "hint": "插件加载后延迟多久再开始第一次后台检查，避免刚重载就发图。",
        "default": 300
      },
      "targets": {
        "description": "固定目标会话",
        "type": "list",
        "hint": "可手动填写 unified_msg_origin；更推荐在聊天里使用 /状态图 开启 自动保存。",
        "default": []
      },
      "caption": {
        "description": "固定状态图文案",
        "type": "string",
        "hint": "主动发送图片前附带的固定一句话。留空则从 caption_templates 或内置角色口吻文案中随机选择。",
        "default": ""
      },
      "caption_templates": {
        "description": "状态图文案模板",
        "type": "list",
        "hint": "按你的角色性格填写多条自然口吻文案，每次随机选一句。支持 {activity}、{outfit}、{time}、{time_period} 占位符。",
        "default": []
      },
      "person_visible": {
        "description": "状态图要求人物入镜",
        "type": "bool",
        "hint": "开启后，主动状态图会要求看到本人或身体局部，例如半身、侧脸、手、肩膀、腿部或镜中倒影，避免只生成桌面空景。",
        "default": true
      },
      "use_selfie_reference": {
        "description": "状态图使用自拍参考",
        "type": "bool",
        "hint": "开启后，如果已经设置自拍参考照，主动状态图会优先用参考照生成同一角色的查岗自拍；失败时会回退到普通文生图。",
        "default": true
      },
      "daily_outfit_enabled": {
        "description": "启用今日穿搭",
        "type": "bool",
        "hint": "开启后，每天会稳定选择一套今日穿搭，并用于主动状态图和自拍提示，避免同一天衣服来回变化。",
        "default": true
      },
      "daily_outfits": {
        "description": "今日穿搭兜底候选",
        "type": "list",
        "hint": "记忆里没有今日穿搭时才使用。插件每天固定随机选择一套，主动状态图和自拍都会尽量沿用。",
        "default": []
      },
      "random_activities": {
        "description": "随机状态兜底候选",
        "type": "list",
        "hint": "记忆里没有当前状态/日程时才使用；留空则按早上/中午/下午/晚上/深夜使用内置状态。",
        "default": []
      },
      "prompt_templates": {
        "description": "状态图提示词模板",
        "type": "list",
        "hint": "每次随机选一个模板生成状态图；留空使用内置有人入镜的生活感查岗模板。支持 {activity}、{outfit}、{time}、{time_period} 占位符。",
        "default": []
      },
      "max_targets_per_tick": {
        "description": "单次最多发送目标数",
        "type": "int",
        "hint": "避免一次性给太多会话发图。",
        "default": 5
      }
    }
  },
  "selfie": {
    "description": "自拍参考照模式",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用自拍参考照",
        "type": "bool",
        "default": true
      },
      "reference_images": {
        "description": "WebUI 上传的自拍参考图",
        "type": "file",
        "hint": "可上传清晰正脸照；不填时，可通过“发送图片 + /自拍参考 设置”保存参考照。",
        "file_types": ["jpg", "jpeg", "png", "webp"],
        "default": []
      },
      "edit_endpoint": {
        "description": "图片编辑接口路径",
        "type": "string",
        "hint": "自拍会使用 OpenAI 兼容 images/edits 接口。",
        "default": "/v1/images/edits"
      },
      "model": {
        "description": "自拍模型",
        "type": "string",
        "hint": "留空时复用上方 model。可填 gpt-image-2、gpt-image-2-2k、gpt-image-2-4k。",
        "default": "gpt-image-2"
      },
      "size": {
        "description": "自拍图片尺寸",
        "type": "string",
        "hint": "默认 auto：自拍/穿搭会自动使用竖图。也可固定为 1024x1024、1024x1536、1536x1024。",
        "default": "auto"
      },
      "quality": {
        "description": "自拍图片质量",
        "type": "string",
        "hint": "留空时复用上方 quality。",
        "default": "auto"
      },
      "output_format": {
        "description": "自拍输出格式",
        "type": "string",
        "hint": "留空时复用上方 output_format。",
        "default": "png"
      },
      "max_reference_images": {
        "description": "最多提交参考图数量",
        "type": "int",
        "hint": "第一张作为身份参考，当前消息中的图片可作为额外服装、姿势、场景参考。",
        "default": 2
      },
      "recent_image_ttl_seconds": {
        "description": "最近图片缓存时间",
        "type": "int",
        "hint": "先发送图片，再输入 /自拍参考 设置 时，图片可被记住多久。",
        "default": 600
      },
      "natural_confirm_enabled": {
        "description": "自然语言确认触发",
        "type": "bool",
        "hint": "开启后，用户说“看看你”“拍张今天照片”“看看今天穿搭”等会记录待确认自拍意图。",
        "default": true
      },
      "natural_confirm_mode": {
        "description": "自然语言确认模式",
        "type": "string",
        "hint": "passive=只记录意图并放行给主 Agent 自然回复；plugin=由插件直接发送确认句。",
        "default": "passive"
      },
      "confirm_ttl_seconds": {
        "description": "自拍确认等待时间",
        "type": "int",
        "hint": "记录待确认自拍意图后，等待用户回复“要看”等确认词的时间。",
        "default": 180
      },
      "image_field": {
        "description": "multipart 图片字段名",
        "type": "string",
        "hint": "多数 OpenAI 兼容 images/edits 使用 image；若网关要求 image[] 可改这里。",
        "default": "image"
      },
      "prompt_prefix": {
        "description": "自拍提示词前缀",
        "type": "text",
        "hint": "留空使用内置提示词：参考图只用于人脸身份，不复刻构图、姿势、背景和光线。",
        "default": ""
      },
      "identity_strength": {
        "description": "身份参考强度",
        "type": "string",
        "hint": "用于提示模型只参考人脸身份。建议 balanced；如果太像原图，改成 loose。",
        "default": "balanced"
      },
      "variation_instruction": {
        "description": "变化约束",
        "type": "text",
        "hint": "默认要求换背景、姿势、构图和镜头距离，避免结果复刻参考图。",
        "default": ""
      },
      "extra_body": {
        "description": "自拍额外请求体参数",
        "type": "object",
        "hint": "用于兼容不同服务商的 images/edits 额外字段。",
        "items": {},
        "default": {}
      }
    }
  }
}
